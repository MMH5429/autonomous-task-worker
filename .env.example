# Which LLM provider the agent uses: "groq" (default) or "ollama"
LLM_PROVIDER=groq

# Groq -- free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama fallback (fully offline). Requires `ollama serve` and the model pulled.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5

# Where the simulated company ERP is listening
ERP_BASE_URL=http://127.0.0.1:8099
